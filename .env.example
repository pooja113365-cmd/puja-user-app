# ============================================================================
# Puja Platform – Customer Mobile App (Expo SDK 52) Environment Configuration
# Copy this file to `.env` (`cp .env.example .env`) before running `npx expo start`
# ============================================================================

# Base URL of the Puja Platform Express REST API:
# - Android Emulator: http://10.0.2.2:5000/api
# - iOS Simulator:    http://localhost:5000/api
# - Physical Device:  http://<YOUR-LAN-IP>:5000/api (e.g. http://192.168.1.20:5000/api)
EXPO_PUBLIC_API_URL=https://puja-backend-o1wr.onrender.com/api

# Socket.io server URL for real-time booking & pandit assignment tracking
EXPO_PUBLIC_SOCKET_URL=https://puja-backend-o1wr.onrender.com
