{
  "expo": {
    "name": "Puja Platform",
    "slug": "puja-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pujaplatform",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": { "backgroundColor": "#6B1D1D" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "in.pujaplatform.app" },
    "android": {
      "package": "in.pujaplatform.app",
      "adaptiveIcon": { "backgroundColor": "#6B1D1D" },
      "usesCleartextTraffic": true
    },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": false }
  }
}

